[Unit]
Description=LLM Gateway - OpenAI-compatible proxy for on-demand model serving
After=network-online.target nvidia-persistenced.service
Wants=network-online.target nvidia-persistenced.service
# Each failed start cycle costs ~190 s (TimeoutStartSec=180 + RestartSec=10).
# 3 attempts × 190 s = 570 s; window of 600 s fits all three before giving up.
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=%LLM_USER%
Group=%LLM_USER%
Environment=HOME=%LLM_HOME%
Environment=PATH=%LLM_PATH%
WorkingDirectory=/etc/llm-gateway
# Cold-boot nvidia-smi can take 60–80 s loading eGPU firmware; leave headroom.
TimeoutStartSec=180

# nvidia-uvm is required by CUDA but not loaded by nvidia-persistenced.
# nvidia-smi probes NVML and triggers GPU firmware loading on Blackwell open RM —
# the step that makes CUDA succeed on cold boot. Both steps run as root (+).
# -+ prefix: run as root, ignore failure so the service still starts without GPU.
ExecStartPre=-+/sbin/modprobe nvidia-uvm
ExecStartPre=-+/usr/bin/nvidia-smi -pm 1

ExecStart=/usr/local/bin/llm-gateway

SupplementaryGroups=render video
LimitMEMLOCK=infinity

# Restrict to explicitly listed devices only.
DevicePolicy=closed

# NVIDIA CUDA device nodes
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-modeset rw
DeviceAllow=/dev/nvidia-uvm rw
DeviceAllow=/dev/nvidia-uvm-tools rw

# AMD/Intel DRI access (iGPU used alongside NVIDIA)
DeviceAllow=/dev/dri/renderD128 rw
DeviceAllow=/dev/dri/renderD129 rw
DeviceAllow=/dev/dri/card0 rw
DeviceAllow=/dev/dri/card1 rw

Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
