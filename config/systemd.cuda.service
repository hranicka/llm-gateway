[Unit]
Description=LLM Gateway - OpenAI-compatible proxy for on-demand model serving
# Wait for nvidia-persistenced before probing the GPU.
# Wants= (not Requires=) so the service still starts without it.
After=network-online.target nvidia-persistenced.service
Wants=network-online.target nvidia-persistenced.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=%LLM_USER%
Group=%LLM_USER%
Environment=HOME=%LLM_HOME%
Environment=PATH=%LLM_PATH%
WorkingDirectory=/etc/llm-gateway

# nvidia-uvm is needed by cuInit() but not loaded by nvidia-persistenced.
# The '+' prefix grants full privileges regardless of User=.
ExecStartPre=+/sbin/modprobe nvidia-uvm

# Wait for /dev/nvidia0 (actual GPU, only exists when driver detects hardware).
# Logs elapsed seconds so boot-timing issues are visible in the journal.
# Exits 0 on timeout so the service still starts without the eGPU.
ExecStartPre=/bin/sh -c 'i=0; while [ ! -c /dev/nvidia0 ] && [ $i -lt 300 ]; do sleep 1; i=$((i+1)); done; echo "llm-gateway: waited ${i}s for /dev/nvidia0" >&2; true'

# After /dev/nvidia0 appears, /dev/nvidia-uvm may need an extra moment.
ExecStartPre=/bin/sh -c 'i=0; while [ ! -c /dev/nvidia-uvm ] && [ $i -lt 10 ]; do sleep 1; i=$((i+1)); done; true'

# Final check: driver must be able to enumerate the GPU.
ExecStartPre=/bin/sh -c 'i=0; while ! nvidia-smi -L >/dev/null 2>&1 && [ $i -lt 10 ]; do sleep 1; i=$((i+1)); done; true'

ExecStart=/usr/local/bin/llm-gateway

# --- GPU & Memory Permissions ---
SupplementaryGroups=render video
LimitMEMLOCK=infinity

# NVIDIA CUDA device nodes (only enforced with PrivateDevices=yes).
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-modeset rw
DeviceAllow=/dev/nvidia-uvm rw
DeviceAllow=/dev/nvidia-uvm-tools rw

# AMD/Intel DRI access (iGPU used alongside NVIDIA).
DeviceAllow=/dev/dri/renderD128 rw
DeviceAllow=/dev/dri/renderD129 rw
DeviceAllow=/dev/dri/card0 rw
DeviceAllow=/dev/dri/card1 rw

Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
