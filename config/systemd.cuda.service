[Unit]
Description=LLM Gateway - OpenAI-compatible proxy for on-demand model serving
After=network-online.target nvidia-persistenced.service
Wants=network-online.target nvidia-persistenced.service
# Keep retrying until the NVIDIA stack is actually ready on cold boot.
StartLimitIntervalSec=0

[Service]
Type=simple
User=%LLM_USER%
Group=%LLM_USER%
Environment=HOME=%LLM_HOME%
Environment=PATH=%LLM_PATH%
WorkingDirectory=/etc/llm-gateway
# A full nvidia-smi query can take about 80 s on cold boot while firmware loads.
TimeoutStartSec=120

# The CUDA unit is strict: if NVIDIA is not ready yet, fail startup and retry.
# Starting the gateway early leads to llama-server falling back to CPU.
# Use full nvidia-smi here, not -pm 1. The full query is what warms the GPU.
ExecStartPre=+/sbin/modprobe nvidia-uvm
ExecStartPre=+/usr/bin/nvidia-smi

ExecStart=/usr/local/bin/llm-gateway

SupplementaryGroups=render video
LimitMEMLOCK=infinity

Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
