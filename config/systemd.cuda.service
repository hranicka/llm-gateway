[Unit]
Description=LLM Gateway - OpenAI-compatible proxy for on-demand model serving
After=network-online.target nvidia-persistenced.service
Wants=network-online.target nvidia-persistenced.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=%LLM_USER%
Group=%LLM_USER%
Environment=HOME=%LLM_HOME%
Environment=PATH=%LLM_PATH%
WorkingDirectory=/etc/llm-gateway

# --- GPU readiness (all steps use '-' or '+' so the service starts without a GPU) ---

# nvidia-uvm is required by cuInit() but not loaded by nvidia-persistenced.
ExecStartPre=+/sbin/modprobe nvidia-uvm

# Wait for the eGPU to appear on the PCIe bus (OCuLink/Thunderbolt).
# Logs elapsed time so boot-timing issues are visible in the journal.
ExecStartPre=-/bin/sh -c 'i=0; while [ ! -c /dev/nvidia0 ] && [ $i -lt 30 ]; do sleep 1; i=$((i+1)); done; echo "llm-gateway: waited ${i}s for /dev/nvidia0" >&2; true'

# Enable GPU persistence mode so the compute engine stays initialized
# between service start and the first request (which may arrive minutes later).
ExecStartPre=-+/usr/bin/nvidia-smi -pm 1

# Wait for the CUDA driver stack — not just NVML — to be ready.
# nvidia-smi uses NVML (ready early on cold boot) but cuInit() needs
# GPU firmware loaded and PCIe BARs mapped. On a dual-GPU system with an
# eGPU over OCuLink, this finishes seconds after the device appears.
# Calls cuInit() directly via Python ctypes; retries up to 30 s.
ExecStartPre=-/bin/sh -c 'i=0; while [ $i -lt 30 ]; do if python3 -c "import ctypes,sys; sys.exit(ctypes.CDLL(\"libcuda.so.1\").cuInit(0))" 2>/dev/null; then echo "llm-gateway: CUDA ready after ${i}s" >&2; break; fi; sleep 1; i=$((i+1)); done; true'

ExecStart=/usr/local/bin/llm-gateway

# --- Permissions ---
SupplementaryGroups=render video
LimitMEMLOCK=infinity

# NVIDIA CUDA device nodes (only enforced with PrivateDevices=yes).
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-modeset rw
DeviceAllow=/dev/nvidia-uvm rw
DeviceAllow=/dev/nvidia-uvm-tools rw

# AMD/Intel DRI access (iGPU used alongside NVIDIA).
DeviceAllow=/dev/dri/renderD128 rw
DeviceAllow=/dev/dri/renderD129 rw
DeviceAllow=/dev/dri/card0 rw
DeviceAllow=/dev/dri/card1 rw

Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target