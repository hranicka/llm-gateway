[Unit]
Description=LLM Gateway - OpenAI-compatible proxy for on-demand model serving
After=network-online.target nvidia-persistenced.service
Wants=network-online.target nvidia-persistenced.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=%LLM_USER%
Group=%LLM_USER%
Environment=HOME=%LLM_HOME%
Environment=PATH=%LLM_PATH%
WorkingDirectory=/etc/llm-gateway

# --- GPU readiness (all steps use '-' or '+' so the service starts without a GPU) ---

# nvidia-uvm is required by cuInit() but not loaded by nvidia-persistenced.
ExecStartPre=+/sbin/modprobe nvidia-uvm

# Wait for the eGPU to be fully ready (OCuLink/Thunderbolt cold boot can take 1-2 min).
# Checks: /dev/nvidia0 exists, /dev/nvidia-uvm exists, and the driver can query the GPU.
# $$ escapes the dollar sign from systemd specifier expansion.
ExecStartPre=-/bin/sh -c 'i=0; while [ $$i -lt 120 ]; do if [ -c /dev/nvidia0 ] && [ -c /dev/nvidia-uvm ] && nvidia-smi --query-gpu=name --format=csv,noheader >/dev/null 2>&1; then echo "llm-gateway: GPU ready after $${i}s" >&2; break; fi; sleep 1; i=$$((i+1)); done; true'

# Enable persistence mode so the compute engine stays initialized between
# service start and the first request (which may arrive minutes later).
ExecStartPre=-+/usr/bin/nvidia-smi -pm 1

ExecStart=/usr/local/bin/llm-gateway

# --- Permissions ---
SupplementaryGroups=render video
LimitMEMLOCK=infinity

# NVIDIA CUDA device nodes
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-modeset rw
DeviceAllow=/dev/nvidia-uvm rw
DeviceAllow=/dev/nvidia-uvm-tools rw

# AMD/Intel DRI access (iGPU used alongside NVIDIA)
DeviceAllow=/dev/dri/renderD128 rw
DeviceAllow=/dev/dri/renderD129 rw
DeviceAllow=/dev/dri/card0 rw
DeviceAllow=/dev/dri/card1 rw

Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
