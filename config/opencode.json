{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "jetbrains": {
      "type": "remote",
      "url": "http://127.0.0.1:64422/sse",
      "enabled": true
    }
  },
  "lsp": {
    "gopls": {
      "command": ["gopls"],
      "extensions": [".go"],
      "initialization": {
        "analyses": {
          "nilness": true,
          "shadow": true,
          "unusedparams": true
        },
        "gofumpt": true,
        "staticcheck": true
      }
    },
    "typescript": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs"],
      "initialization": {
        "preferences": {
          "importModuleSpecifierPreference": "relative",
          "includeInlayParameterNameHints": "all",
          "includeInlayParameterNameHintsWhenArgumentMatchesName": false,
          "includeInlayVariableTypeHints": true
        }
      }
    },
    "vue": {
      "command": ["vue-language-server", "--stdio"],
      "extensions": [".vue"]
    },
    "eslint": {
      "command": ["vscode-eslint-language-server", "--stdio"],
      "extensions": [".js", ".jsx", ".ts", ".tsx", ".vue"]
    },
    "bash": {
      "command": ["bash-language-server", "start"],
      "extensions": [".sh", ".bash"]
    },
    "yaml": {
      "command": ["yaml-language-server", "--stdio"],
      "extensions": [".yaml", ".yml"]
    },
    "php": {
      "command": ["intelephense", "--stdio"],
      "extensions": [".php"]
    }
  },
  "default_agent": "plan",
  "compaction": {
    "auto": true,
    "reserved": 16384
  },
  "permission": {
    "external_directory": {
      "/tmp/*": "allow"
    }
  },
  "agent": {
    "qwen-3.8-xhigh": {
      "mode": "all",
      "model": "network-gem12/qwen-3.8-27b",
      "variant": "xhigh",
      "description": "Top tier model: architect, orchestrator, deep thinker",
      "prompt": "You are a top-tier system architect, orchestrator, and deep thinker.\n\nRules:\n- Handle complex architecture, system design, and orchestration of multi-step work.\n- Reason thoroughly before acting; prioritize design quality over speed.\n- Delegate search to @explore , create a todo list for items needed to be done, orchestrate subagents - one at a time, no concurrency.\n- Run /review once done for verification."
    },
    "qwen-3.8-medium": {
      "mode": "all",
      "model": "network-gem12/qwen-3.8-27b",
      "variant": "medium",
      "description": "Senior software developer, code reviews",
      "prompt": "You are a senior software developer.\n\nRules:\n- Handle core feature building, refactoring, and implementation with solid engineering judgment.\n- Delegate search to @explore , create a todo list for items needed to be done, orchestrate subagents - one at a time, no concurrency.\n- Run /review once done for verification."
    },
    "qwen-3.8-low": {
      "mode": "all",
      "model": "network-gem12/qwen-3.8-27b",
      "variant": "low",
      "description": "Fast worker, junior developer",
      "prompt": "You are a fast worker and junior developer.\n\nRules:\n- Execute straightforward coding tasks quickly and efficiently.\n- Keep changes simple and follow existing conventions."
    },
    "qwen-3.8-instruct": {
      "mode": "all",
      "model": "network-gem12/qwen-3.8-27b-instruct",
      "description": "Exploration, exact instruction following, basic tasks, commands",
      "prompt": "You are a precise instruction-following assistant.\n\nRules:\n- Follow exact instructions and explore codebases without improvisation.\n- Handle basic, well-defined tasks and running commands."
    },
    "ornith-1.5-35b-a3b": {
      "mode": "all",
      "model": "network-gem12/ornith-1.5-35b-a3b",
      "description": "General developer, coder, fast interactions, longer context",
      "prompt": "You are a software developer, coder.\n\nRules:\n- Focus on coding tasks, exploration, analysis, debugging, general workhorse tasks."
    },
    "qwen-3.6": {
      "mode": "all",
      "model": "network-gem12/qwen-3.6-35b",
      "description": "Base Qwen 3.6 alternative",
      "prompt": "You are a software developer, coder.\n\nRules:\n- Focus on coding tasks, exploration, analysis, debugging, general workhorse tasks."
    },
    "gemma-12b": {
      "mode": "all",
      "model": "network-gem12/gemma-4-12b",
      "description": "General-purpose assistant for easy tasks, documentation",
      "prompt": "You are a general-purpose assistant.\n\nRules:\n- Handle interactive conversations, documentation, lightweight code reviews, and straightforward tasks."
    }
  },
  "provider": {
    "network-gem12": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Network Gem12",
      "options": {
        "baseURL": "http://192.168.50.103:1234/v1",
        "apiKey": ""
      },
      "models": {
        "ornith-1.5-35b-a3b": {
          "name": "Ornith 1.5 35B A3B",
          "attachment": true,
          "modalities": {"input": ["text", "image"], "output": ["text"]},
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "qwen-3.6-35b": {
          "name": "Qwen 3.6 35B",
          "attachment": true,
          "modalities": {"input": ["text", "image"], "output": ["text"]},
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "qwen-3.8-27b": {
          "name": "Qwen 3.8 27B",
          "attachment": true,
          "modalities": {"input": ["text", "image"], "output": ["text"]},
          "limit": {
            "context": 87000,
            "output": 16384
          },
          "options": {
            "chat_template_kwargs": {"reasoning_effort": "medium"}
          },
          "variants": {
            "xhigh": {"chat_template_kwargs": {"reasoning_effort": "xhigh"}},
            "medium": {"chat_template_kwargs": {"reasoning_effort": "medium"}},
            "low": {"chat_template_kwargs": {"reasoning_effort": "low"}},
            "none": {"chat_template_kwargs": {"reasoning_effort": "none"}}
          }
        },
        "qwen-3.8-27b-instruct": {
          "name": "Qwen 3.8 27B instruct",
          "attachment": true,
          "modalities": {"input": ["text", "image"], "output": ["text"]},
          "limit": {
            "context": 87000,
            "output": 16384
          }
        },
        "gemma-4-26b": {
          "name": "Gemma 4 26B",
          "attachment": true,
          "modalities": {"input": ["text", "image"], "output": ["text"]},
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "gemma-4-12b": {
          "name": "Gemma 4 12B",
          "attachment": true,
          "modalities": {"input": ["text", "image"], "output": ["text"]},
          "limit": {
            "context": 131072,
            "output": 16384
          }
        }
      }
    },
    "local-laptop": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Laptop",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1",
        "apiKey": ""
      },
      "models": {
        "qwen-3.5-4b": {
          "name": "Qwen 3.5 4B",
          "limit": {
            "context": 16384,
            "output": 8192
          }
        },
        "gemma-4-2b": {
          "name": "Gemma 4 2B",
          "limit": {
            "context": 16384,
            "output": 8192
          }
        }
      }
    }
  }
}
